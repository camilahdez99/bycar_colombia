# Copiar a .env.local y completar. Nunca commitear valores reales.

# Oracle (lib/db.js) — obligatorias
DB_USER=
DB_PASSWORD=
DB_CONNECTION_STRING=

# Secreto de la cookie de sesión, mínimo 32 caracteres. Sin él, el login no emite cookie.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Admin del login (S5). Si falta alguna de las dos, el login de admin queda deshabilitado.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Feature flags (apagados por defecto)
# true = la API exige sesión y rol
AUTH_ENFORCED=
# Entero positivo = segundos de Cache-Control en menus, marcas y municipios
CATALOG_CACHE_SECONDS=
