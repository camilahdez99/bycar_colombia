// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DELETE /api/admin/tablas (caracterización) > 200: borra por PK con el id como texto (F14) y autoCommit (comportamiento actual: sin autenticación) 1`] = `
[
  {
    "binds": {
      "tabla": "USUARIOS",
    },
    "options": undefined,
    "sql": "
    SELECT UPPER(kcu.column_name) AS column_name
    FROM information_schema.table_constraints tc
    JOIN information_schema.key_column_usage kcu
      ON tc.constraint_name = kcu.constraint_name
     AND tc.table_schema = kcu.table_schema
    WHERE tc.constraint_type = 'PRIMARY KEY'
      AND tc.table_schema = current_schema()
      AND tc.table_name = LOWER(:tabla)
    ORDER BY kcu.ordinal_position
  ",
  },
  {
    "binds": {
      "id": "7",
    },
    "options": {
      "autoCommit": true,
    },
    "sql": "
      DELETE FROM USUARIOS
      WHERE ID_USU = :id
    ",
  },
]
`;

