]
`;

exports[`PUT /api/xpress (caracterización) > edición: actualiza descripción y peso solo si sigue Pendiente 1`] = `
[
  {
    "binds": {
      "cargaId": 3,
    },
    "options": undefined,
    "sql": "
    SELECT c.USUARIO_EMISOR_US AS "emisorId",
           c.USUARIO_RECEPTOR_US AS "receptorId",
           COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) AS "conductorId",
           c.VIAJE_ID AS "viajeId",
           c.ESTADO_ID_EST_XP AS "estadoId"
    FROM CARGAS c
    LEFT JOIN VIAJES v ON c.VIAJE_ID = v.ID_VIA
    WHERE c.ID_XP = :cargaId
  ",
  },
  {
    "binds": {
      "cargaId": 3,
      "descripcion": "Sobre",
      "pendiente": 1,
      "peso": 1,
    },
    "options": {
      "autoCommit": true,
    },
    "sql": "
      UPDATE CARGAS SET DESCRIPCION_XP = :descripcion, PESO_XP = :peso
      WHERE ID_XP = :cargaId AND ESTADO_ID_EST_XP = :pendiente
    ",
  },
]
`;
