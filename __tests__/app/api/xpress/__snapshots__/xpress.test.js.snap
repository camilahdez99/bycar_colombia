exports[`POST /api/xpress (caracterización) > 201: valida el viaje y el receptor, e inserta la carga Pendiente 1`] = `
[
  {
    "binds": {
      "idXp": undefined,
      "viajeId": 5,
    },
    "options": undefined,
    "sql": "SELECT USUARIOS_ID_USU AS "conductorId", ESTADO_VIA_ID_EST_VIA AS "estadoId" FROM VIAJES WHERE ID_VIA = :viajeId",
  },
  {
    "binds": {
      "email": "luis@x.co",
      "idXp": undefined,
    },
    "options": undefined,
    "sql": "SELECT ID_USU FROM USUARIOS WHERE UPPER(CORREO_USU) = UPPER(:email)",
  },
  {
    "binds": {
      "descripcion": "Caja con libros",
      "estadoId": 1,
      "idXp": "ID",
      "peso": 2.5,
      "receptorId": 8,
      "usuarioId": 7,
      "viajeId": 5,
    },
    "options": {
      "autoCommit": true,
    },
    "sql": "
  INSERT INTO CARGAS (ID_XP, DESCRIPCION_XP, PESO_XP, USUARIO_EMISOR_US, USUARIO_RECEPTOR_US, VIAJE_ID, ESTADO_ID_EST_XP, FECHA_CREACION_XP)
  VALUES (:idXp, :descripcion, :peso, :usuarioId, :receptorId, :viajeId, :estadoId, CURRENT_TIMESTAMP)
",
  },
]
`;

exports[`PUT /api/xpress (caracterización) > cambio de estado: pasa de Pendiente a Aceptada con el estado actual en el WHERE 1`] = `
[
  {
