exports[`DELETE /api/xpress (caracterización) > cancelación lógica: UPDATE a Cancelada, nunca DELETE 1`] = `
[
  {
    "binds": {
      "cargaId": 3,
    },
    "options": undefined,
    "sql": "
    SELECT c.USUARIO_EMISOR_US AS "emisorId",
           c.USUARIO_RECEPTOR_US AS "receptorId",
           COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) AS "conductorId",
           c.VIAJE_ID AS "viajeId",
           c.ESTADO_ID_EST_XP AS "estadoId"
    FROM CARGAS c
    LEFT JOIN VIAJES v ON c.VIAJE_ID = v.ID_VIA
    WHERE c.ID_XP = :cargaId
  ",
  },
  {
    "binds": {
      "cargaId": 3,
      "estadoActual": 2,
      "estadoNuevo": 6,
    },
    "options": {
      "autoCommit": true,
    },
    "sql": "UPDATE CARGAS SET ESTADO_ID_EST_XP = :estadoNuevo WHERE ID_XP = :cargaId AND ESTADO_ID_EST_XP = :estadoActual",
  },
]
`;

exports[`GET /api/xpress (caracterización) > conductor: filtra por el conductor del viaje y, opcional, por viaje 1`] = `
[
  {
    "binds": {
      "usuarioId": 9,
    },
    "options": undefined,
    "sql": "
      SELECT c.ID_XP AS "id",
             c.DESCRIPCION_XP AS "descripcion",
             c.PESO_XP AS "peso",
             c.ESTADO_ID_EST_XP AS "estadoId",
             es.ESTADO_EST_XP AS "estado",
             TO_CHAR(c.FECHA_CREACION_XP, 'YYYY-MM-DD HH24:MI') AS "fecha",
             v.ID_VIA AS "viajeId",
             mo.NOMBRE_MUN AS "origen",
             md.NOMBRE_MUN AS "destino",
             TO_CHAR(v.TIEMPO_SALIDA_VIA, 'YYYY-MM-DD HH24:MI') AS "salida",
             TO_CHAR(c.FECHA_XP, 'YYYY-MM-DD') AS "fechaXp",
             c.USUARIO_EMISOR_US AS "emisorId",
             ue.NOMBRE_USU || ' ' || ue.APELLIDO_USU AS "emisor",
             c.USUARIO_RECEPTOR_US AS "receptorId",
             ur.NOMBRE_USU || ' ' || ur.APELLIDO_USU AS "receptor",
             uc.ID_USU AS "conductorId",
             uc.NOMBRE_USU || ' ' || uc.APELLIDO_USU AS "conductor"
      FROM CARGAS c
      JOIN ESTADOS_XPRESS es ON c.ESTADO_ID_EST_XP = es.ID_EST_XP
      LEFT JOIN VIAJES v ON c.VIAJE_ID = v.ID_VIA
      JOIN MUNICIPIOS mo ON COALESCE(v.MUNICIPIO_ORIGEN_ID, c.ORIGEN_ID) = mo.ID_MUN
      JOIN MUNICIPIOS md ON COALESCE(v.MUNICIPIOS_DESTINO_ID, c.DESTINO_ID) = md.ID_MUN
      JOIN USUARIOS ue ON c.USUARIO_EMISOR_US = ue.ID_USU
      JOIN USUARIOS ur ON c.USUARIO_RECEPTOR_US = ur.ID_USU
      LEFT JOIN USUARIOS uc ON COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) = uc.ID_USU
      WHERE COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) = :usuarioId
      ORDER BY c.FECHA_CREACION_XP DESC
    ",
  },
  {
    "binds": {
      "usuarioId": 9,
      "viajeId": 5,
    },
    "options": undefined,
    "sql": "
      SELECT c.ID_XP AS "id",
             c.DESCRIPCION_XP AS "descripcion",
             c.PESO_XP AS "peso",
             c.ESTADO_ID_EST_XP AS "estadoId",
             es.ESTADO_EST_XP AS "estado",
             TO_CHAR(c.FECHA_CREACION_XP, 'YYYY-MM-DD HH24:MI') AS "fecha",
             v.ID_VIA AS "viajeId",
             mo.NOMBRE_MUN AS "origen",
             md.NOMBRE_MUN AS "destino",
             TO_CHAR(v.TIEMPO_SALIDA_VIA, 'YYYY-MM-DD HH24:MI') AS "salida",
             TO_CHAR(c.FECHA_XP, 'YYYY-MM-DD') AS "fechaXp",
             c.USUARIO_EMISOR_US AS "emisorId",
             ue.NOMBRE_USU || ' ' || ue.APELLIDO_USU AS "emisor",
             c.USUARIO_RECEPTOR_US AS "receptorId",
             ur.NOMBRE_USU || ' ' || ur.APELLIDO_USU AS "receptor",
             uc.ID_USU AS "conductorId",
             uc.NOMBRE_USU || ' ' || uc.APELLIDO_USU AS "conductor"
      FROM CARGAS c
      JOIN ESTADOS_XPRESS es ON c.ESTADO_ID_EST_XP = es.ID_EST_XP
      LEFT JOIN VIAJES v ON c.VIAJE_ID = v.ID_VIA
      JOIN MUNICIPIOS mo ON COALESCE(v.MUNICIPIO_ORIGEN_ID, c.ORIGEN_ID) = mo.ID_MUN
      JOIN MUNICIPIOS md ON COALESCE(v.MUNICIPIOS_DESTINO_ID, c.DESTINO_ID) = md.ID_MUN
      JOIN USUARIOS ue ON c.USUARIO_EMISOR_US = ue.ID_USU
      JOIN USUARIOS ur ON c.USUARIO_RECEPTOR_US = ur.ID_USU
      LEFT JOIN USUARIOS uc ON COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) = uc.ID_USU
      WHERE COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) = :usuarioId AND c.VIAJE_ID = :viajeId
      ORDER BY c.FECHA_CREACION_XP DESC
    ",
  },
]
`;

exports[`GET /api/xpress (caracterización) > mis envíos (vista por defecto): filtra por emisor y devuelve las filas tal cual 1`] = `
[
  {
    "binds": {
      "usuarioId": 7,
    },
    "options": undefined,
    "sql": "
      SELECT c.ID_XP AS "id",
             c.DESCRIPCION_XP AS "descripcion",
             c.PESO_XP AS "peso",
             c.ESTADO_ID_EST_XP AS "estadoId",
             es.ESTADO_EST_XP AS "estado",
             TO_CHAR(c.FECHA_CREACION_XP, 'YYYY-MM-DD HH24:MI') AS "fecha",
             v.ID_VIA AS "viajeId",
             mo.NOMBRE_MUN AS "origen",
             md.NOMBRE_MUN AS "destino",
             TO_CHAR(v.TIEMPO_SALIDA_VIA, 'YYYY-MM-DD HH24:MI') AS "salida",
             TO_CHAR(c.FECHA_XP, 'YYYY-MM-DD') AS "fechaXp",
             c.USUARIO_EMISOR_US AS "emisorId",
             ue.NOMBRE_USU || ' ' || ue.APELLIDO_USU AS "emisor",
             c.USUARIO_RECEPTOR_US AS "receptorId",
             ur.NOMBRE_USU || ' ' || ur.APELLIDO_USU AS "receptor",
             uc.ID_USU AS "conductorId",
             uc.NOMBRE_USU || ' ' || uc.APELLIDO_USU AS "conductor"
      FROM CARGAS c
      JOIN ESTADOS_XPRESS es ON c.ESTADO_ID_EST_XP = es.ID_EST_XP
      LEFT JOIN VIAJES v ON c.VIAJE_ID = v.ID_VIA
      JOIN MUNICIPIOS mo ON COALESCE(v.MUNICIPIO_ORIGEN_ID, c.ORIGEN_ID) = mo.ID_MUN
      JOIN MUNICIPIOS md ON COALESCE(v.MUNICIPIOS_DESTINO_ID, c.DESTINO_ID) = md.ID_MUN
      JOIN USUARIOS ue ON c.USUARIO_EMISOR_US = ue.ID_USU
      JOIN USUARIOS ur ON c.USUARIO_RECEPTOR_US = ur.ID_USU
      LEFT JOIN USUARIOS uc ON COALESCE(v.USUARIOS_ID_USU, c.CONDUCTOR_ID_USU) = uc.ID_USU
      WHERE c.USUARIO_EMISOR_US = :usuarioId
      ORDER BY c.FECHA_CREACION_XP DESC
    ",
  },
]
`;

